# Keeps indentation and line endings the same in every editor, so a diff shows
# what changed and not who opened the file. This is the floor; .prettierrc and
# pint.json do the rest.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# JSON keeps the four spaces above, the way Composer writes composer.json. These
# two belong to npm, and npm always writes two.
[{package.json,package-lock.json}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
max_line_length = 90
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{sql,html}]
max_line_length = off
