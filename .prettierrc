{
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "embeddedLanguageFormatting": "off",
    "overrides": [
        {
            "files": "*.md",
            "options": {
                "printWidth": 90,
                "tabWidth": 2,
                "proseWrap": "preserve"
            }
        },
        {
            "files": "*.{json,yml,yaml}",
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
