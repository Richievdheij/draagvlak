# Dependencies, installed with composer install and npm install.
/vendor/
/node_modules/

# Operating system leftovers.
.DS_Store
.idea/
*.swp

# Editor settings are shared, so only the two files the team agreed on are kept.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Local overrides and logs. Your database password lives in config.local.php
# and stays on your own machine. Pint keeps its cache in the system temp folder,
# so there is nothing to ignore for the formatter.
config.local.php
.env
.env.local
*.log
