# Dependencies, installed with composer install and npm install.
/vendor/
/node_modules/

# Operating system leftovers.
.DS_Store
.idea/
*.swp

# Editor settings are shared, so only the two files the team agreed on are kept.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Local overrides, caches and logs. Your database password lives in
# config.local.php and stays on your own machine.
config.local.php
.env
.env.local
*.log
.php-cs-fixer.cache

# Persoonlijke skills van je eigen installatie horen niet bij dit project.
.claude/skills/brainstorm/
